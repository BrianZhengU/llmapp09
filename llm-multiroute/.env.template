# Copy to .env and fill in. Never commit .env.

# Ollama Cloud (key provided by the trainer, valid only during the training period)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=<REPLACE_WITH_OLLAMA_API_KEY>
# Use your local Ollama instead:
# OLLAMA_BASE_URL=http://localhost:11434

# Default model for every task
DEFAULT_MODEL=gpt-oss:20b

# Multi-model routing: override the model per task (MODEL_<TASK>)
# MODEL_SUMMARIZE=gpt-oss:20b
# MODEL_GENERATE=gpt-oss:120b
# MODEL_EXTRACT=gpt-oss:20b
# MODEL_CLASSIFY=gpt-oss:20b
# MODEL_SENTIMENT=gpt-oss:20b
# MODEL_INTENT=gpt-oss:20b
# MODEL_SUPPORT_TECHNICAL=qwen3-coder:480b
# MODEL_SUPPORT_BILLING=gpt-oss:20b
# MODEL_SUPPORT_PRESALES=gpt-oss:120b
# MODEL_SUPPORT_GENERAL=gpt-oss:20b

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
# Log full prompts/outputs (may contain PII) - local debugging only
LOG_PROMPTS=false

# Langfuse (https://cloud.langfuse.com > your project > Settings > API Keys)
LANGFUSE_PUBLIC_KEY=<REPLACE_WITH_LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<REPLACE_WITH_LANGFUSE_SECRET_KEY>
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com   or your self-hosted URL
LANGFUSE_HOST=<HOSTNAME_FROM_LANGFUSE>

# OpenAI: optional LLM provider (MODEL_<TASK>=openai/gpt-4o-mini) and DeepEval judge
OPENAI_API_KEY=<REPLACE_WITH_OPENAI_API_KEY>

# Guardrails
GUARDRAIL_MAX_INPUT_CHARS=8000
# redact (default) | block | off
GUARDRAIL_PII_MODE=redact
# Optional LLM safety classifier on the same Ollama endpoint, e.g. local: ollama pull llama-guard3:1b
# GUARDRAIL_LLM_MODEL=llama-guard3:1b
